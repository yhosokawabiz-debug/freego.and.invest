# サイトの公開URL（決済完了後の戻り先に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DB（開発: SQLite / 本番: PostgreSQL 推奨 → schema.prisma の provider も変更）
DATABASE_URL="file:./dev.db"

# Stripe（カード / Apple Pay / Google Pay / コンビニ / 銀行振込 / PayPay / 定期便）
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# `stripe listen` または Dashboard の Webhook 設定で表示される署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Paidy（あと払い） https://merchant.paidy.com/
PAIDY_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAIDY_PUBLIC_KEY=pk_test_xxx

# NP後払い（請求書後払い）— ネットプロテクションズとの加盟店契約後に発行される値
NP_ATOBARAI_API_URL=
NP_ATOBARAI_MERCHANT_ID=
NP_ATOBARAI_SP_CODE=
NP_ATOBARAI_TERMINAL_ID=
